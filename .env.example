# ========================================================
# Antikor 8.0 - Adıyaman & İlçeleri Taziye Otomasyonu
# Ortam Değişkenleri Şablonu
# ========================================================

# 1. Firebase Hizmet Hesabı (Service Account JSON)
# Firebase Console -> Proje Ayarları -> Hizmet Hesapları -> Yeni Özel Anahtar Oluştur
# İndirilen JSON içeriğini tek satır string veya base64 olarak buraya yapıştırın.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Alternatif olarak yerel geliştirme için dosya yolu belirtebilirsiniz:
# FIREBASE_SERVICE_ACCOUNT_PATH="./serviceAccountKey.json"

# 2. Firestore Koleksiyon Adı (Varsayılan: taziyeler)
# Tüm ilçeler (Kahta, Besni, Adıyaman Merkez) tek ortak koleksiyonda 'ilce' alanı ile saklanır.
# Böylece Adıyaman Güncel Admin'den tüm il tek sorguda yönetilebilir.
FIRESTORE_COLLECTION="taziyeler"

# 3. Bağımsız FCM Push Bildirim Konuları (Topics)
# Her ilçe için bağımsız mobil uygulamalar (Kahta Güncel Cepte, Besni Güncel Cepte, Adıyaman Güncel Cepte):
FCM_TOPIC_KAHTA="taziyeler_kahta"
FCM_TOPIC_BESNI="taziyeler_besni"
FCM_TOPIC_MERKEZ="taziyeler_merkez"

# Eski Kahta Cepte uygulaması uyumluluğu için varsayılan topic:
FCM_TOPIC="taziyeler"
FCM_TOPIC_LEGACY="true"

# Tüm Adıyaman il geneli ortak topic (Adıyaman Güncel Cepte tüm ili dinlemek isterse):
FCM_TOPIC_ALL="taziyeler_all"

# 4. Güvenlik Anahtarları
# /api/sync endpoint'i koruması (Cron tetikleyicisi)
CRON_SECRET="adiyaman_taziye_guvenlik_anahtari_2026"

# /api/admin endpoint'i koruması (Admin panel taziye ekleme/silme)
ADMIN_SECRET="adiyaman_admin_secret_key_2026"
